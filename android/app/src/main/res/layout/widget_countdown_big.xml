<?xml version="1.0" encoding="utf-8"?>
<!-- Đếm ngược 4×2+: chữ trái, linh vật lớn phải -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_lacquer_bg" android:orientation="horizontal" android:paddingLeft="16dp" android:paddingRight="8dp" android:paddingTop="14dp" android:paddingBottom="12dp" android:clipToOutline="true">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="2" android:ellipsize="end" android:text="Tết Nguyên Đán" android:textColor="@color/widget_on_lacquer_gold" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="bottom">
            <TextView android:id="@+id/number" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="@font/noto_serif_digits" android:gravity="bottom" android:text="75" android:textColor="@color/widget_on_accent" android:includeFontPadding="false" android:maxLines="1"
                android:textSize="64sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="28sp" android:autoSizeMaxTextSize="88sp" android:shadowColor="#66000000" android:shadowDy="3" android:shadowRadius="6" />
            <TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:paddingLeft="8dp" android:paddingBottom="8dp" android:text="ngày nữa" android:textColor="@color/widget_on_lacquer_soft" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Thứ Bảy, 6/2 · 1/1 Âm" android:textColor="@color/widget_on_lacquer_soft" android:textSize="12sp" />
    </LinearLayout>
    <ImageView android:id="@+id/mascot" android:layout_width="120dp" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_mascot_lantern" android:contentDescription="Linh vật" />
</LinearLayout>
