<?xml version="1.0" encoding="utf-8"?>
<!-- Đồng hồ & lịch âm · kiểu Sơn mài · 4×3+. Giờ là TextClock của hệ thống: tự chạy, không tốn pin -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:clipToOutline="true">
    <LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_band_full" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/noto_serif_digits" android:includeFontPadding="false" android:text="23" android:textColor="@color/widget_on_accent" android:textSize="60sp" android:maxLines="1" android:shadowColor="#40000000" android:shadowDy="2" android:shadowRadius="4" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="10dp">
            <TextView android:id="@+id/weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Thứ Hai" android:textColor="@color/widget_on_lacquer_soft" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/lunar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="15/10 Âm" android:textColor="@color/widget_on_lacquer_gold" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/year" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Năm Bính Ngọ" android:textColor="@color/widget_on_lacquer_gold" android:textSize="11sp" android:visibility="visible"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="end">
            <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:includeFontPadding="false" android:textColor="@color/widget_on_accent" android:textSize="46sp" android:textStyle="bold" android:letterSpacing="-0.02" android:maxLines="1" />
            <TextView android:id="@+id/hzline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Giờ Tỵ · hoàng đạo" android:textColor="@color/widget_on_lacquer_soft" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="10dp" android:paddingRight="12dp" android:paddingTop="10dp">
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:fontFamily="@font/be_vietnam_pro" android:text="Không có sự kiện trong 4 tháng tới" android:textColor="@color/widget_muted" android:textSize="12sp" />
        <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/dot0" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_ic_moon" android:contentDescription="Loại ngày" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="7dp" android:paddingRight="6dp">
                <TextView android:id="@+id/title0" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Rằm tháng Mười" android:textColor="@color/widget_ink" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/date0" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:text="T2 23/11" android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/count0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:background="@drawable/widget_pill" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="4 ngày" android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout android:id="@+id/sep1" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_line" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/dot1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_ic_moon" android:contentDescription="Loại ngày" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="7dp" android:paddingRight="6dp">
                <TextView android:id="@+id/title1" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Rằm tháng Mười" android:textColor="@color/widget_ink" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/date1" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:text="T2 23/11" android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/count1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:background="@drawable/widget_pill" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="4 ngày" android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout android:id="@+id/sep2" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_line" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/dot2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_ic_moon" android:contentDescription="Loại ngày" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="7dp" android:paddingRight="6dp">
                <TextView android:id="@+id/title2" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Rằm tháng Mười" android:textColor="@color/widget_ink" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/date2" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:text="T2 23/11" android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/count2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:background="@drawable/widget_pill" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="4 ngày" android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout android:id="@+id/sep3" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_line" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/dot3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_ic_moon" android:contentDescription="Loại ngày" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="7dp" android:paddingRight="6dp">
                <TextView android:id="@+id/title3" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Rằm tháng Mười" android:textColor="@color/widget_ink" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/date3" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:text="T2 23/11" android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/count3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:background="@drawable/widget_pill" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="4 ngày" android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
