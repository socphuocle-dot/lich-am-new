<?xml version="1.0" encoding="utf-8"?>
<!-- Lịch & sắp tới 4×1: ô ngày nhỏ + việc gần nhất -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="horizontal" android:gravity="center_vertical" android:padding="6dp" android:clipToOutline="true">
    <LinearLayout android:layout_width="64dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_lacquer_panel">
        <TextView android:id="@+id/day" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fontFamily="@font/noto_serif_digits" android:gravity="center" android:text="23" android:textColor="@color/widget_on_accent" android:includeFontPadding="false" android:maxLines="1"
            android:textSize="30sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="36sp" />
        <TextView android:id="@+id/lunar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:paddingBottom="4dp" android:text="15/10 Âm" android:textColor="@color/widget_on_lacquer_gold" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp" android:paddingRight="4dp">
        <TextView android:id="@+id/weekday" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:text="THỨ HAI · SẮP TỚI" android:textColor="@color/widget_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.06" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:fontFamily="@font/be_vietnam_pro" android:text="Không có sự kiện trong 4 tháng tới" android:textColor="@color/widget_muted" android:textSize="12sp" />
        <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/dot0" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_ic_moon" android:contentDescription="Loại ngày" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="7dp" android:paddingRight="6dp">
                <TextView android:id="@+id/title0" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Rằm tháng Mười" android:textColor="@color/widget_ink" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/date0" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:text="T2 23/11" android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/count0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:background="@drawable/widget_pill" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="4 ngày" android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
