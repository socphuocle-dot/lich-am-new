<?xml version="1.0" encoding="utf-8"?>
<!-- Đồng hồ & lịch âm · kiểu Giấy · 4×1. Giờ là TextClock của hệ thống: tự chạy, không tốn pin -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:clipToOutline="true" android:gravity="center_vertical">
    <LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="6dp" android:paddingRight="12dp" android:paddingTop="6dp">
        <LinearLayout android:layout_width="52dp" android:layout_height="56dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_lacquer_panel">
            <TextView android:id="@+id/weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:text="THỨ HAI" android:textColor="@color/widget_on_lacquer_gold" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/noto_serif_digits" android:includeFontPadding="false" android:text="23" android:textColor="@color/widget_on_accent" android:textSize="28sp" android:maxLines="1" android:shadowColor="#40000000" android:shadowDy="2" android:shadowRadius="4" />
            <TextView android:id="@+id/lunar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:text="15/10 Âm" android:textColor="@color/widget_on_lacquer_gold" android:textSize="9.5sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp">
            <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:includeFontPadding="false" android:textColor="@color/widget_ink" android:textSize="30sp" android:textStyle="bold" android:letterSpacing="-0.02" android:maxLines="1" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:visibility="gone">
                <TextView android:id="@+id/hz2tall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:background="@drawable/widget_chip_gold" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:maxLines="1" android:text="Bính Ngọ" android:textColor="@color/widget_gold_ink" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/hzline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Giờ Tỵ · hoàng đạo" android:textColor="@color/widget_gold_ink" android:textSize="11sp" android:textStyle="bold" android:visibility="visible"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <ImageView android:id="@+id/moon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/widget_moon_15" android:contentDescription="Trăng hôm nay" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:visibility="gone"><TextView android:id="@+id/hz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:background="@drawable/widget_pill_now" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:maxLines="1" android:text="Giờ Tỵ" android:textColor="@color/widget_on_accent" android:textSize="11sp" android:textStyle="bold" /></LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
