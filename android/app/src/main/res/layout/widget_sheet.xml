<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingBottom="8dp">
        <TextView android:id="@+id/band" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro"
            android:background="@drawable/widget_band" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="7dp"
            android:text="THÁNG 11 · 2026" android:textColor="@color/widget_on_accent" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:shadowColor="#40000000" android:shadowDy="2" android:shadowRadius="4" />
        <TextView android:id="@+id/day" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fontFamily="@font/noto_serif_digits"
            android:gravity="center" android:text="21" android:textColor="@color/widget_accent" android:includeFontPadding="false" android:maxLines="1"
            android:textSize="50sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="26sp" android:autoSizeMaxTextSize="68sp" android:shadowColor="#40000000" android:shadowDy="2" android:shadowRadius="4" />
        <TextView android:id="@+id/weekday" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="@font/be_vietnam_pro"
            android:text="Thứ Bảy" android:textColor="@color/widget_muted" android:textSize="12sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_marginTop="3dp" android:background="@drawable/widget_chip_gold" android:paddingLeft="4dp" android:paddingRight="9dp">
            <ImageView android:id="@+id/giap" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_giap_11" android:contentDescription="Con giáp của ngày" />
            <TextView android:id="@+id/lunar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:paddingLeft="3dp"
                android:paddingTop="2dp" android:paddingBottom="2dp" android:maxLines="1" android:ellipsize="end" android:text="13/10 Âm · Kỷ Hợi" android:textColor="@color/widget_gold_ink" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/note" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="@font/be_vietnam_pro"
            android:maxLines="1" android:ellipsize="end" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="4dp"
            android:text="Ngày Hoàng đạo" android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <ImageView android:id="@+id/moon" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="top|end" android:layout_marginTop="38dp" android:layout_marginRight="8dp"
        android:src="@drawable/widget_moon_13" android:contentDescription="Trăng hôm nay" />
</FrameLayout>
