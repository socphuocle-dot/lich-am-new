<?xml version="1.0" encoding="utf-8"?>
<!-- Đồng hồ & lịch âm · kiểu Sơn mài · 4×1. Giờ là TextClock của hệ thống: tự chạy, không tốn pin -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:clipToOutline="true" android:gravity="center_vertical">
    <LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_band_full" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/noto_serif_digits" android:includeFontPadding="false" android:text="23" android:textColor="@color/widget_on_accent" android:textSize="34sp" android:maxLines="1" android:shadowColor="#40000000" android:shadowDy="2" android:shadowRadius="4" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="10dp">
            <TextView android:id="@+id/weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Thứ Hai" android:textColor="@color/widget_on_lacquer_soft" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/lunar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="15/10 Âm" android:textColor="@color/widget_on_lacquer_gold" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/year" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Năm Bính Ngọ" android:textColor="@color/widget_on_lacquer_gold" android:textSize="11sp" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="end">
            <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:includeFontPadding="false" android:textColor="@color/widget_on_accent" android:textSize="30sp" android:textStyle="bold" android:letterSpacing="-0.02" android:maxLines="1" />
            <TextView android:id="@+id/hzline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Giờ Tỵ · hoàng đạo" android:textColor="@color/widget_on_lacquer_soft" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
