<?xml version="1.0" encoding="utf-8"?>
<!-- Tờ lịch 2×1: số ngày + thứ, ngày âm, ghi chú -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="8dp" android:paddingRight="28dp">
        <TextView android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="@font/noto_serif_digits" android:gravity="center" android:text="23" android:textColor="@color/widget_accent" android:includeFontPadding="false" android:maxLines="1"
            android:textSize="44sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="22sp" android:autoSizeMaxTextSize="54sp" android:minWidth="54dp" android:shadowColor="#40000000" android:shadowDy="2" android:shadowRadius="4" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="6dp">
            <TextView android:id="@+id/weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Thứ Hai" android:textColor="@color/widget_muted" android:textSize="11.5sp" android:textStyle="bold" />
            <TextView android:id="@+id/lunar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="15/10 Âm" android:textColor="@color/widget_gold_ink" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Hoàng đạo" android:textColor="@color/widget_accent" android:textSize="10.5sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/moon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:layout_marginTop="8dp" android:layout_marginRight="8dp" android:src="@drawable/widget_moon_15" android:contentDescription="Trăng hôm nay" />
</FrameLayout>
