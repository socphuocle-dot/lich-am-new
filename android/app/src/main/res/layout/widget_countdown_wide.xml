<?xml version="1.0" encoding="utf-8"?>
<!-- Đếm ngược 4×1: số ngày + tên dịp + linh vật -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_lacquer_bg" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="14dp" android:paddingRight="8dp" android:clipToOutline="true">
    <TextView android:id="@+id/number" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="@font/noto_serif_digits" android:gravity="center_vertical" android:text="75" android:textColor="@color/widget_on_accent" android:includeFontPadding="false" android:maxLines="1"
        android:textSize="40sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="48sp" android:shadowColor="#66000000" android:shadowDy="3" android:shadowRadius="6" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="ngày nữa" android:textColor="@color/widget_on_lacquer_soft" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:paddingLeft="4dp" android:text="đến Tết" android:textColor="@color/widget_on_lacquer_gold" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end" android:text="Thứ Bảy 6/2 · 1/1 Âm" android:textColor="@color/widget_on_lacquer_soft" android:textSize="11.5sp" />
    </LinearLayout>
    <ImageView android:id="@+id/mascot" android:layout_width="60dp" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_mascot_lantern" android:contentDescription="Linh vật" />
</LinearLayout>
