<?xml version="1.0" encoding="utf-8"?>
<!-- 4×1 "Bé Thỏ nhắc": linh vật + lời nhắn theo ngày -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="4dp" android:paddingRight="8dp" android:paddingTop="4dp" android:paddingBottom="4dp">
    <ImageView android:id="@+id/mascot" android:layout_width="64dp" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_mascot_wave" android:contentDescription="Bé Thỏ Ngọc" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
        android:background="@drawable/widget_bubble" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="6dp" android:paddingBottom="7dp">
        <TextView android:id="@+id/tip_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:ellipsize="end"
            android:text="Chào buổi sáng! Thứ Bảy 21/11" android:textColor="@color/widget_ink" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/tip_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:maxLines="2" android:ellipsize="end"
            android:text="Còn 2 ngày nữa là Rằm tháng Mười" android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingLeft="8dp">
        <ImageView android:id="@+id/moon" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/widget_moon_13" android:contentDescription="Trăng hôm nay" />
        <TextView android:id="@+id/lunar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro"
            android:text="13/10" android:textColor="@color/widget_gold_ink" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
