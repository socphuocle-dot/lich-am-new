<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1 "Ngày hôm nay": trông như biểu tượng lịch, số ngày tự đổi theo ngày của máy -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="3dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:background="@drawable/widget_icon_white" android:gravity="center_horizontal" android:paddingTop="5dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro"
            android:text="THỨ BẢY" android:textColor="@color/widget_accent" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:maxLines="1" />
        <TextView android:id="@+id/day" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="21" android:textColor="@color/widget_ink"
            android:textSize="28sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="44sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/moon" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/widget_moon_13" android:contentDescription="Trăng" />
            <TextView android:id="@+id/lunar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro" android:paddingLeft="3dp"
                android:text="13/10" android:textColor="@color/widget_gold_ink" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
