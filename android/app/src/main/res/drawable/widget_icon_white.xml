<?xml version="1.0" encoding="utf-8"?>
<!-- Biểu tượng ngày kiểu lịch iPhone: nền trắng bo tròn, đổ bóng nhẹ -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp" android:left="1dp" android:right="1dp"><shape android:shape="rectangle"><corners android:radius="20dp"/><solid android:color="#33000000"/></shape></item>
    <item android:bottom="2dp"><shape android:shape="rectangle"><corners android:radius="20dp"/>
        <gradient android:angle="270" android:startColor="@color/widget_icon_top" android:endColor="@color/widget_icon_bottom"/>
        <stroke android:width="1dp" android:color="@color/widget_line"/></shape></item>
</layer-list>
